{
    "tasks": {
        "bundle-velotype-jsx": "deno bundle jsr:@velotype/velotype/jsx-runtime --output ./build/velotype-jsx-runtime.mjs --sourcemap=linked",
        "bundle-velotype-jsx-min": "deno bundle --minify jsr:@velotype/velotype/jsx-runtime --output ./build/velotype-jsx-runtime.min.mjs --sourcemap=linked",
        "bundle-velotype-jsxdev": "deno bundle jsr:@velotype/velotype/jsx-dev-runtime --output ./build/velotype-jsx-dev-runtime.mjs --sourcemap=linked",
        "bundle-velotype-jsxdev-min": "deno bundle --minify jsr:@velotype/velotype/jsx-dev-runtime --output ./build/velotype-jsx-dev-runtime.min.mjs --sourcemap=linked",
        "bundle": "deno bundle ./browser/main.tsx --output ./build/main.mjs --sourcemap=linked --external jsr:@velotype/velotype",
        "bundle-min": "deno bundle --minify ./browser/main.tsx --output ./build/main.min.mjs --sourcemap=linked --external jsr:@velotype/velotype",
        "dev-server": "deno run --allow-net --allow-env --allow-sys --allow-ffi --allow-read --watch --inspect ./server/index.ts",
        "prod-server": "RUN_MODE=local-optimized deno run --allow-net --allow-env --allow-sys --allow-ffi --allow-read ./server/index.ts"
    },
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "jsr:@velotype/velotype",
        "lib": ["dom", "esnext"]
    },
    "imports": {
        "@velotype/velotype": "jsr:@velotype/velotype@^0.0.17"
    }
}